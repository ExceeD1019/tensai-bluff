# ---- API キー ----
# お題生成AI・検証AI に使用
ANTHROPIC_API_KEY=

# LLM_PROVIDER=openai にしたときだけ必要
OPENAI_API_KEY=

# ---- プロバイダ / モデル ----
# anthropic (既定) または openai
LLM_PROVIDER=anthropic

# お題生成モデル。品質重視なら claude-opus-5、コスト重視なら claude-sonnet-5
GENERATION_MODEL=claude-opus-5
# 検証(事実チェック・推測可能性判定)モデル。精度が要るので下げすぎ注意
VERIFY_MODEL=claude-opus-5

# openai を使う場合の例:
# LLM_PROVIDER=openai
# GENERATION_MODEL=gpt-5
# VERIFY_MODEL=gpt-5

# ---- 再生成の上限 ----
MAX_REGEN_ATTEMPTS=3
